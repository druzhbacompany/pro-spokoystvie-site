# Lead delivery for /api/lead.
# Without a configured channel the endpoint answers 503 and the form shows an
# error — a lead nobody receives must never look delivered to the patient.
# Copy to .env.local (dev) or set in the PM2 env (prod). Never commit real secrets.

# --- Channel 1: SMTP (preferred) ---
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on port 465; leave empty to derive from SMTP_PORT
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Channel 2: Resend (used only when SMTP_HOST is empty) ---
RESEND_API_KEY=

# --- Recipient / sender (both channels) ---
LEAD_EMAIL_TO=info@pro-spokoystvie.ru
LEAD_EMAIL_FROM=noreply@pro-spokoystvie.ru
